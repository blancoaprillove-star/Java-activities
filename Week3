public class Multitierdiscountsystem {
  public static void main(String[] args) {
        double purchaseAmount = 6000;
        double discountRate;

        if (purchaseAmount >= 5000) {
            discountRate = 0.15;
        } else if (purchaseAmount >= 3000) {
            discountRate = 0.10;
        } else if (purchaseAmount >= 1000) {
            discountRate = 0.05;
        } else {
            discountRate = 0.00;
        }

        double discount = purchaseAmount * discountRate;
        double finalPrice = purchaseAmount - discount;

        System.out.println("Purchase Amount: " + purchaseAmount);
        System.out.println("Discount Tier: " + (discountRate * 100) + "%");
        System.out.println("Final Discounted Price: " + finalPrice);
    }
}  



public class Nestedloginvaliditor {
 public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        String correctUsername = "admin";
        String correctPassword = "12345";
        boolean accountLocked = false;

        System.out.print("Enter username: ");
        String username = sc.nextLine();

        if (username.equals(correctUsername)) {

            System.out.print("Enter password: ");
            String password = sc.nextLine();

            if (password.equals(correctPassword)) {

                if (!accountLocked) {
                    System.out.println("Login successful. Welcome!");
                } else {
                    System.out.println("Login failed: Account is locked.");
                }

            } else {
                System.out.println("Login failed: Incorrect password.");
            }

        } else {
            System.out.println("Login failed: Username not found.");
        }

    }
}
   


public class AtmtransactionAuthorizer {
public static void main(String[] args) {
    try (Scanner sc = new Scanner(System.in)) {
        String validUsername = "admin";
        int validPin = 1234;

        System.out.print("Enter username: ");
        String username = sc.nextLine();

        System.out.print("Enter 4-digit PIN: ");
        int pin = sc.nextInt();

        // Nested if for login validation
        if (username.equals(validUsername)) {
            if (pin == validPin) {

                System.out.print("Enter account balance: ");
                double balance = sc.nextDouble();

                System.out.print("Enter withdrawal amount: ");
                double withdrawAmount = sc.nextDouble();

                // Else-if ladder for account tier
                String tier;
                double dailyLimit;

                if (balance < 10000) {
                    tier = "Bronze";
                    dailyLimit = 2000;
                } else if (balance < 50000) {
                    tier = "Silver";
                    dailyLimit = 5000;
                } else if (balance < 100000) {
                    tier = "Gold";
                    dailyLimit = 10000;
                } else {
                    tier = "Platinum";
                    dailyLimit = 20000;
                }

                System.out.println("Account Tier: " + tier);

                // Switch for transaction fee percentage
                double feeRate;
                feeRate = switch (tier) {
                    case "Bronze" -> 0.05;
                    case "Silver" -> 0.03;
                    case "Gold" -> 0.02;
                    case "Platinum" -> 0.01;
                    default -> 0;
                };

                double fee = withdrawAmount * feeRate;
                double totalDeduction = withdrawAmount + fee;

                // Nested if for withdrawal authorization
                if (withdrawAmount <= dailyLimit) {
                    if (totalDeduction <= balance) {
                        System.out.println("APPROVED");
                        System.out.println("Withdrawal Amount: " + withdrawAmount);
                        System.out.println("Transaction Fee: " + fee);
                        System.out.println("Remaining Balance: " + (balance - totalDeduction));
                    } else {
                        System.out.println("DENIED: Insufficient balance.");
                    }
                } else {
                    System.out.println("DENIED: Exceeds daily limit for " + tier + " account.");
                }

            } else {
                System.out.println("DENIED: Incorrect PIN.");
            }
        } else {
            System.out.println("DENIED: Invalid username.");
        }
    }
    }
}


                  
                  
