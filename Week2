public class CompoundGrowthIncrementTracker {
 public static void main(String[] args) {
        double balance = 1000;

        balance += 200;
        System.out.println("After adding 200: " + balance);

        balance *= 1.10;
        System.out.println("After 10% growth: " + balance);

        balance += 100;
        System.out.println("After adding 100: " + balance);
 
        int count = 5;

        System.out.println("Postfix increment: " + count++);
        System.out.println("After postfix: " + count);

        // Prefix increments first, so it displays the updated value.
        System.out.println("Prefix increment: " + ++count);
        System.out.println("After prefix: " + count);
    }
}



public class FourFunctionCalculator {


    public static void main(String[] args) {
        try (Scanner input = new Scanner(System.in)) {
            System.out.print("Enter first number: ");
            double num1 = input.nextDouble();
            
            System.out.print("Enter second number: ");
            double num2 = input.nextDouble();
            
            System.out.println("Addition: " + (num1 + num2));
            System.out.println("Subtraction: " + (num1 - num2));
            System.out.println("Multiplication: " + (num1 * num2));
            
            // Division by zero is not allowed.
            if (num2 != 0) {
                System.out.println("Division: " + (num1 / num2));
            } else {
                System.out.println("Division: Cannot divide by zero.");
            }
        }
    }
}

 
public class GradeThresholdChecker {
public static void main(String[] args) {
    try (Scanner input = new Scanner(System.in)) {
        System.out.print("Enter average grade: ");
        double average = input.nextDouble();

        System.out.print("Enter number of absences: ");
        int absences = input.nextInt();

        if ((average >= 75 && absences <= 3) || average >= 90) {
            System.out.println("PASS");
            System.out.println("You meet the grade requirements.");
        } else {
            System.out.println("FAIL");
            System.out.println("You do not meet the grade requirements.");
        }
    }
    }
}
   


public class PrecedencePuzzleSolver {
public static void main(String[] args) {
        int a = 5, b = 3, c = 2;

        // Expression 1: Arithmetic happens before comparison.
        System.out.println("Expression 1: " + (a + b * c > 10));
        // Prediction: true
        // Actual result: true

        // Expression 2: Increment happens before multiplication.
        int x = 4;
        System.out.println("Expression 2: " + (++x * 2 == 10));
        // Prediction: true
        // Actual result: true

        // Expression 3: Relational operators happen before logical AND.
        int y = 6;
        System.out.println("Expression 3: " + (y > 5 && y-- == 6));
        // Prediction: true
        // Actual result: true

        System.out.println("Final value of x: " + x);
        System.out.println("Final value of y: " + y);
    }
}
    



