public class OverfloeandReferenceInvestigator {
public static void main(String[] args) {

        // 1. Primitive Overflow
        byte num = 127; // maximum value of byte
        System.out.println("Before increment: " + num);

        num++;
        System.out.println("After increment: " + num);

        // 2. String Comparisons
        String str1 = "Hello";
        String str2 = "Hello";
        String str3 = "Hello";

        System.out.println("\nString Comparisons:");
        System.out.println("str1 == str2: " + (str1.equals(str2)));
        System.out.println("str1.equals(str2): " + str1.equals(str2));

        System.out.println("str1 == str3: " + (str1.equals(str3)));
        System.out.println("str1.equals(str3): " + str1.equals(str3));

        System.out.println("str2 == str3: " + (str2.equals(str3)));
        System.out.println("str2.equals(str3): " + str2.equals(str3));

        // 3. Shared Array Reference
        int[] arr1 = {10, 20, 30};
        int[] arr2 = arr1; // same array reference

        arr2[0] = 99;

        System.out.println("\nArray Reference Sharing:");
        System.out.println("arr1[0] = " + arr1[0]);
        System.out.println("arr2[0] = " + arr2[0]);
    }
}       

