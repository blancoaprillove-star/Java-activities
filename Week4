        }

    }
}



public class Sumuntilsentinelvalue {
  public static void main(String[] args) {
      try (Scanner input = new Scanner(System.in)) {
          int number;
          int sum = 0;
          
          System.out.println("Sum Until Sentinel Value");
          System.out.println("Enter -1 to stop.");
          
          System.out.print("Enter a number: ");
          number = input.nextInt();
          
          while (number != -1) {
              sum += number;
              
              System.out.print("Enter a number: ");
              number = input.nextInt();
          }
          
          System.out.println("Total sum: " + sum);
      }
    }
}
  



public class Patterngeneratorwithearlyexit {
 public static void main(String[] args) {

        int size = 5;

        for (int i = 1; i <= size; i++) {

            // continue: skip printing row 3
            if (i == 3) {
                continue;
            }

            for (int j = 1; j <= size; j++) {

                // break: stop the inner loop when j reaches 4
                if (j == 4) {
                    break;
                }

                System.out.print("* ");
            }

            System.out.println();
        }
    }
}
   



public class Warehouseinventoryscanner {
  public static void main(String[] args) {
      try (Scanner input = new Scanner(System.in)) {
          int[][] warehouse = {
              {10, 15, 20},
              {8, -1, 12},
              {5, 18, 25}
          };
          
          int choice;
          
          do {
              System.out.println("\n=== Warehouse Inventory Scanner ===");
              System.out.println("1. Display Inventory");
              System.out.println("2. Calculate Total Inventory");
              System.out.println("3. Find First Damaged Shelf");
              System.out.println("4. Simulate Restocking");
              System.out.println("5. Exit");
              System.out.print("Enter your choice: ");
              choice = input.nextInt();
              
              switch (choice) {
                  case 1 -> {
                      System.out.println("\nWarehouse Inventory:");
                      
                      for (int[] warehouse1 : warehouse) {
                          for (int j = 0; j < warehouse1.length; j++) {
                              System.out.print(warehouse1[j] + "\t");
                          }
                          System.out.println();
                      }
                  }
                  
                  
                  case 2 -> {
                      int total = 0;
                      
                      for (int[] warehouse1 : warehouse) {
                          for (int j = 0; j < warehouse1.length; j++) {
                              if (warehouse1[j] == -1) {
                                  continue;
                              }
                              total += warehouse1[j];
                          }
                      }
                      
                      System.out.println("Total inventory: " + total);
                  }
                  
                  
                  case 3 -> {
                      boolean found = false;
                      
                      for (int i = 0; i < warehouse.length; i++) {
                          for (int j = 0; j < warehouse[i].length; j++) {
                              if (warehouse[i][j] == -1) {
                                  System.out.println(
                                          "First damaged shelf found at Row "
                                                  + (i + 1) + ", Column " + (j + 1)
                                  );
                                  found = true;
                                  break;
                              }
                          }
                          
                          if (found) {
                              break;
                          }
                      }
                      
                      if (!found) {
                          System.out.println("No damaged shelf found.");
                      }
                  }
                  
                  case 4 -> {
                      int row, col, quantity;
                      System.out.print("Enter row (1-3): ");
                      row = input.nextInt();
                      System.out.print("Enter column (1-3): ");
                      col = input.nextInt();
                      if (row < 1 || row > warehouse.length
                              || col < 1 || col > warehouse[0].length) {
                          System.out.println("Invalid shelf location.");
                          break;
                      }
                      if (warehouse[row - 1][col - 1] == -1) {
                          System.out.println("Cannot restock a damaged shelf.");
                          break;
                      }
                      quantity = 0;
                      while (quantity <= 0) {
                          System.out.print("Enter restock quantity (positive number): ");
                          quantity = input.nextInt();
                          
                          if (quantity <= 0) {
                              System.out.println("Invalid quantity. Try again.");
                          }
                      }
                      warehouse[row - 1][col - 1] += quantity;
                      System.out.println("Restocking successful!");
                      System.out.println("Updated shelf quantity: "
                              + warehouse[row - 1][col - 1]);
                  }
                  
                  case 5 -> System.out.println("Exiting Warehouse Inventory Scanner...");
                  
                  default -> System.out.println("Invalid choice. Please try again.");
              }
              
          } while (choice != 5);
      }
    }
}
